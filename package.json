{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "A voice-activated desktop assistant inspired by Marvel's J.A.R.V.I.S.",
  "main": "src/main/main.js",
  "author": "icymaster4356",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/icymaster4356/jarvis-desktop.git"
  },
  "keywords": [
    "jarvis",
    "voice-assistant",
    "electron",
    "desktop",
    "hud"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder",
    "dist:deb": "electron-builder --linux deb",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.icymaster4356.jarvis",
    "productName": "Jarvis",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons"
    },
    "deb": {
      "maintainer": "icymaster4356",
      "description": "A voice-activated desktop assistant with a sci-fi HUD interface, inspired by Marvel's J.A.R.V.I.S.",
      "synopsis": "Voice-activated desktop assistant",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libdrm2",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    }
  }
}
